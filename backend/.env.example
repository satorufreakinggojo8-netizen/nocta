# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Prisma format)
DATABASE_URL="postgresql://user:password@localhost:5432/nocta"

# JWT signing secrets — use long random strings, different for each
JWT_SECRET="replace-me"
JWT_REFRESH_SECRET="replace-me-too"

# Anthropic API key — used ONLY server-side in src/services/aiCoach.ts.
# The Android client never sees this value.
ANTHROPIC_API_KEY="sk-ant-..."

PORT=4000
